<Window x:Class="ScreenshotSorter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenshotSorter の設定"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="監視フォルダ" FontWeight="SemiBold" Margin="0,0,0,6" />

        <DockPanel Grid.Row="1" LastChildFill="True">
            <Button x:Name="ResetFolderButton" DockPanel.Dock="Right" Content="既定に戻す" Padding="10,3" Margin="6,0,0,0" Click="ResetFolderButton_Click" />
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="参照..." Padding="10,3" Margin="6,0,0,0" Click="BrowseButton_Click" />
            <TextBox x:Name="FolderTextBox" VerticalContentAlignment="Center" Padding="2,3" />
        </DockPanel>

        <TextBlock Grid.Row="2" x:Name="DefaultFolderText" Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <CheckBox x:Name="SortExistingCheckBox" Margin="0,0,0,8">
                <TextBlock Text="起動時に、監視フォルダ直下にたまっている画像もまとめて整理する" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="StartWithWindowsCheckBox">
                <TextBlock Text="Windows 起動時に自動で起動する" />
            </CheckBox>
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,16,0,0" Foreground="#666" TextWrapping="Wrap">
            <Run x:Name="LogPathRun" />
            <LineBreak />
            <Hyperlink Click="OpenDataFolder_Click">ログ・設定フォルダを開く</Hyperlink>
        </TextBlock>

        <DockPanel Grid.Row="5" Margin="0,20,0,0" LastChildFill="False">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#666" />
            <Button DockPanel.Dock="Right" Content="キャンセル" MinWidth="90" Padding="10,4" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="保存" MinWidth="90" Padding="10,4" IsDefault="True" Click="SaveButton_Click" />
        </DockPanel>
    </Grid>
</Window>
