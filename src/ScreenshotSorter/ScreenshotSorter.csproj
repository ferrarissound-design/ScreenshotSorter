<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイ (NotifyIcon) のためだけに WinForms も使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Windows 以外の環境でもビルドだけはできるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ScreenshotSorter</RootNamespace>
    <AssemblyName>ScreenshotSorter</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 単一 exe・ランタイム同梱 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF アプリなので DPI 設定は manifest で行う（WinForms 用の警告を抑制） -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenshotSorter.Core\ScreenshotSorter.Core.csproj" />
  </ItemGroup>

</Project>
